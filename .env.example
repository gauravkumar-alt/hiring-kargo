# Gemini (Google AI Studio -> aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: override the model used for scoring and drafting
GEMINI_MODEL=gemini-flash-latest

# Resend (resend.com -> API Keys)
RESEND_API_KEY=
# Optional. Defaults to Resend's test sender "Kargo Hiring <onboarding@resend.dev>",
# which only delivers to your Resend account's email. Set it once a domain is verified.
FROM_EMAIL=

# Used in email sign-offs
SENDER_NAME=Arjun
COMPANY_NAME=Kargo

# Supabase (supabase.com -> your project -> Project Settings -> API)
# Run supabase/migrations/0001_init.sql once in the SQL Editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password for the dashboard. Leave empty locally; set it before deploying anywhere public.
APP_PASSWORD=

# Test mode: while set, every email goes to this inbox instead of the candidate
# (subject is tagged with who it was meant for). Remove once a domain is verified in Resend.
EMAIL_TEST_REDIRECT=
